{
  "name": "Graphene Vector Design Studio",
  "short_name": "Graphene",
  "description": "Professional vector graphics editor — bezier pen, node editing, gradients, layers, SVG/PNG export.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#16171c",
  "theme_color": "#16171c",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": { "application/json": [".graphene", ".json"] }
    }
  ]
}
